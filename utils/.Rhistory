library(treeio)
library(ape)
library(phangorn)
library(dplyr)
# Function to count monophyletic groups for a given location type
count_monophyletic_groups <- function(tree_phylo, tip_info, location_type) {
# Get all tips of this location type
tips_of_type <- tip_info$tip_number[tip_info$type == location_type]
if (length(tips_of_type) == 0) {
return(0)
}
if (length(tips_of_type) == 1) {
# Single tip is trivially monophyletic
return(1)
}
# Track which tips have been assigned to a monophyletic group
unassigned_tips <- tips_of_type
group_count <- 0
while (length(unassigned_tips) > 0) {
# Start from an unassigned tip
current_tip <- unassigned_tips[1]
current_node <- current_tip
# Trace upward to find the maximal monophyletic group containing this tip
while (TRUE) {
# Get parent node
parent_node <- tree_phylo$edge[tree_phylo$edge[, 2] == current_node, 1]
# If no parent (reached root), stop
if (length(parent_node) == 0) {
break
}
# Get all descendant tips of the parent node
parent_descendants <- phangorn::Descendants(tree_phylo, parent_node, type = "tips")[[1]]
# Check if all descendants are of the target location type
if (all(parent_descendants %in% tips_of_type)) {
# All descendants are monophyletic, continue tracing upward
current_node <- parent_node
} else {
# Found a node with mixed descendants, stop here
break
}
}
# current_node is now the root of a maximal monophyletic group
# Get all tips in this group
if (current_node <= length(tree_phylo$tip.label)) {
# current_node is still a tip (no parent had all descendants of target type)
group_tips <- current_node
} else {
# current_node is an internal node
group_tips <- phangorn::Descendants(tree_phylo, current_node, type = "tips")[[1]]
}
# Remove these tips from unassigned list
unassigned_tips <- setdiff(unassigned_tips, group_tips)
# Increment group count
group_count <- group_count + 1
}
return(group_count)
}
# Read the tree file
tree_file <- "/Users/lukelyu/Desktop/epidata/100_10_new/1_beast2.trees"
cat("Reading tree file:", tree_file, "\n")
tree <- read.beast(tree_file)
# Handle tree structure
if (is.null(names(tree))) {
tree <- list(STATE_0 = tree)
}
# Get the first tree
first_tree_name <- names(tree)[1]
cat("Using tree:", first_tree_name, "\n\n")
first_tree <- tree[[first_tree_name]]
tree_phylo <- as.phylo(first_tree)
n_tips <- length(tree_phylo$tip.label)
# Extract tip information
tip_info <- first_tree@data %>%
filter(node %in% 1:n_tips) %>%
arrange(as.numeric(node)) %>%
transmute(
tip_number = as.numeric(node),
tip_label = tree_phylo$tip.label[as.numeric(node)],
type = gsub("I\\{|\\}", "", type)
)
# Get unique location types
all_types <- unique(tip_info$type)
cat("Location types found:", paste(all_types, collapse = ", "), "\n\n")
# Count tips per location
cat("Tips per location:\n")
for (loc in sort(all_types)) {
n_tips_loc <- sum(tip_info$type == loc)
cat("  ", loc, ": ", n_tips_loc, " tips\n", sep = "")
}
cat("\n")
# Test the count_monophyletic_groups function for each location
cat("Monophyletic groups per location:\n")
for (loc in sort(all_types)) {
n_groups <- count_monophyletic_groups(tree_phylo, tip_info, loc)
n_tips_loc <- sum(tip_info$type == loc)
cat("  ", loc, ": ", n_groups, " groups (", n_tips_loc, " tips)\n", sep = "")
}
cat("\nTest completed successfully!\n")
